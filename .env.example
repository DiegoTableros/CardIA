# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.

# --- Aplicacion ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:4200

# --- Base de datos (SQLite; en Vercel usar /tmp/cardia.db) ---
DATABASE_URL=sqlite+aiosqlite:///./data/cardia.db

# --- Seguridad (JWT) ---
# Genera uno: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-bytes
ACCESS_TOKEN_TTL_MINUTES=120

# --- Usuarios semilla ---
SEED_ADMIN_EMAIL=admin@cardia.local
SEED_ADMIN_PASSWORD=admin1234
SEED_DEMO_EMAIL=demo@cardia.local
SEED_DEMO_PASSWORD=demo1234

# --- LLM (opcional; sin clave el chat usa modo sin LLM) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-5.1
LLM_MODEL_FAST=gpt-5.1-mini

# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.

# --- Aplicacion ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:4200

# --- Base de datos (SQLite; en Vercel usar /tmp/cardia.db) ---
DATABASE_URL=sqlite+aiosqlite:///./data/cardia.db

# --- Seguridad (JWT) ---
# Genera uno: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-bytes
ACCESS_TOKEN_TTL_MINUTES=120

# --- Usuarios semilla ---
SEED_ADMIN_EMAIL=admin@cardia.local
SEED_ADMIN_PASSWORD=admin1234
SEED_DEMO_EMAIL=demo@cardia.local
SEED_DEMO_PASSWORD=demo1234

# --- LLM (opcional; sin clave el asistente responde con reglas y los mismos datos) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_MODEL_FAST=gpt-5.4-mini
# low | medium | high; dejar vacio si el modelo no es de razonamiento
LLM_REASONING_EFFORT=low
# low | medium | high (verbosidad de las respuestas del asistente)
LLM_VERBOSITY=medium
LLM_MAX_PLAN_STEPS=6
LLM_TIMEOUT_SECONDS=45
LLM_HISTORY_TURNS=4

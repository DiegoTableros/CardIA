{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git commit": "ask",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "gh repo create*": "ask",
      "gh pr *": "ask",
      "Remove-Item *": "ask",
      "rm *": "ask",
      "winget *": "ask",
      "npm publish*": "deny",
      "vercel --prod*": "ask"
    }
  },
  "tool_output": { "max_lines": 150, "max_bytes": 6144 }
}
